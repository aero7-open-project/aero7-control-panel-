#!/usr/bin/python3
"""Keep the KDE Settings launcher out of Aero7 unless enabled in Aero7 Features."""

import json
import os
import subprocess
import sys
from pathlib import Path

MARKER = "# Managed by Aero7 Features\n"
LAUNCHERS = ("systemsettings.desktop", "kdesystemsettings.desktop")


def paths():
    home = Path.home()
    config = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
    data = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))
    return config / "aero7/system-settings.json", data / "applications"


def enabled(state_file):
    if not state_file.exists():
        return False
    state = json.loads(state_file.read_text(encoding="utf-8"))
    if not isinstance(state, dict) or not isinstance(state.get("enabled"), bool):
        raise ValueError("Invalid Aero7 System Settings visibility state")
    return state["enabled"]


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
    try:
        temporary.write_text(content, encoding="utf-8")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def reconcile(show, applications):
    applications.mkdir(parents=True, exist_ok=True)
    targets = [applications / name for name in LAUNCHERS]
    for target in targets:
        if target.exists() and not target.read_text(encoding="utf-8").startswith(MARKER):
            raise ValueError(f"A custom launcher already exists: {target}")
    changed = False
    if show:
        for target in targets:
            if target.exists():
                target.unlink()
                changed = True
    else:
        hidden_entry = (MARKER + "[Desktop Entry]\nType=Application\n"
                        "Name=KDE System Settings\nHidden=true\nNoDisplay=true\n")
        for target in targets:
            if not target.exists() or target.read_text(encoding="utf-8") != hidden_entry:
                atomic_write(target, hidden_entry)
                changed = True
    return changed


def refresh_services():
    program = os.environ.get("AERO7_KBUILDSYCOCA", "/usr/bin/kbuildsycoca6")
    if Path(program).exists():
        subprocess.run([program, "--noincremental"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=30, check=False)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("ensure", "enable", "disable", "status"):
        print("Usage: aero7-system-settings-visibility {ensure|enable|disable|status}",
              file=sys.stderr)
        return 64
    state_file, applications = paths()
    try:
        show = enabled(state_file)
        if sys.argv[1] == "status":
            print("enabled" if show else "disabled")
            return 0
        if sys.argv[1] != "ensure":
            show = sys.argv[1] == "enable"
        changed = reconcile(show, applications)
        if sys.argv[1] != "ensure":
            atomic_write(state_file, json.dumps({"enabled": show}) + "\n")
        if changed:
            refresh_services()
        return 0
    except (OSError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired) as exc:
        print(f"Aero7 could not update System Settings visibility: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
